# Runtime
APP_NAME="T.A.I.S API"
# Optional: override package version from pyproject.toml [project].version
# APP_VERSION=0.6.0
ENVIRONMENT=development
# Development accepts all origins/hosts. Production must use explicit HTTPS
# origins and public API host names (wildcards are rejected at startup).
CORS_ORIGINS=["*"]
TRUSTED_HOSTS=["*"]

# PostgreSQL / PgVector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agno_aios
POSTGRES_PASSWORD=agno_aios
POSTGRES_DB=agno_aios
# Application control-plane schemas
TAIS_APP_SCHEMA=app
TAIS_MCP_SCHEMA=mcp
TAIS_KNOWLEDGE_SCHEMA=knowledge
# Agno engine persistence schema only
AGNO_DB_SCHEMA=agno

# Logging
LOG_LEVEL=INFO
LOG_DIR=.logs
LOG_FILE=poc.log

# Auth
AUTH_JWT_SECRET=replace-with-long-random-secret
AUTH_RESET_PASSWORD_SECRET=replace-with-long-random-secret
AUTH_VERIFICATION_SECRET=replace-with-long-random-secret
AUTH_OAUTH_STATE_SECRET=replace-with-long-random-secret
AUTH_TOKEN_LIFETIME_SECONDS=3600
AUTH_COOKIE_SECURE=false
OAUTH_ASSOCIATE_BY_EMAIL=true
OAUTH_IS_VERIFIED_BY_DEFAULT=true
# Optional bootstrap admin
# TAIS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# TAIS_BOOTSTRAP_ADMIN_PASSWORD=AdminPass123!

# OAuth providers
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common
MICROSOFT_OAUTH_REDIRECT_URL=

# Agent / MCP
MCP_SERVER_URL=http://127.0.0.1:8000/mcp/
MCP_TOKEN=replace-with-mcp-token
TAIS_SKILLS_DIR=api/agent/skills
TAIS_SKILLS_CONFIG_FILE=.config/skills_config.json

# Knowledge
TAIS_KNOWLEDGE_PGVECTOR_TABLE=security_knowledge_vectors
TAIS_POSTGRES_KNOWLEDGE_TABLE=agno_knowledge
TAIS_KNOWLEDGE_NAME=security_knowledge
TAIS_KNOWLEDGE_UPLOAD_DIR=.config/knowledge_uploads
TAIS_KNOWLEDGE_TOP_K=5
# Minimum similarity/hybrid score (0-1). 0/empty disables filtering; empty results allowed.
TAIS_KNOWLEDGE_SIMILARITY_THRESHOLD=0.35
TAIS_KNOWLEDGE_VECTOR_SCORE_WEIGHT=0.55
TAIS_KNOWLEDGE_SEARCH_TYPE=hybrid
TAIS_KNOWLEDGE_CONTENT_LANGUAGE=english
TAIS_KNOWLEDGE_PREFIX_MATCH=false
TAIS_KNOWLEDGE_CHUNK_SIZE=1200
TAIS_KNOWLEDGE_CHUNK_OVERLAP=160
TAIS_KNOWLEDGE_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
TAIS_KNOWLEDGE_EMBEDDING_DIMENSIONS=512
TAIS_KNOWLEDGE_RERANK_MODEL=BAAI/bge-reranker-base
TAIS_KNOWLEDGE_RERANK_ENABLED=true
TAIS_KNOWLEDGE_RERANK_CANDIDATE_MULTIPLIER=3
TAIS_KNOWLEDGE_RERANK_MIN_CANDIDATES=10

# CVE update cache
# TAIS_CVE_SOURCE_CONFIG_PATH=cve_sources.toml
TAIS_CVE_DATA_DIR=.config/cve

# Collect optional browser fallback (patchright + Chrome)
# TAIS_COLLECT_USE_PLAYWRIGHT=false
# TAIS_COLLECT_PLAYWRIGHT_HEADLESS=true
# TAIS_COLLECT_PLAYWRIGHT_USER_DATA=
