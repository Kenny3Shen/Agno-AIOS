{
  "name": "frontend",
  "version": "0.6.0",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14",
    "@types/node": "^25.9.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29",
    "msw": "^2",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "typescript": "~6.0.3",
    "unocss": "^66.7.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "bun@1.3.4",
  "private": true,
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "bun run typecheck && vite build",
    "lint": "oxlint src vite.config.ts uno.config.ts --deny-warnings",
    "lint:fix": "oxlint src vite.config.ts uno.config.ts --fix",
    "format": "oxfmt --write --disable-nested-config",
    "format:check": "oxfmt --check --disable-nested-config",
    "test": "vitest run",
    "test:related": "vitest related --run",
    "test:profile": "vitest run --reporter=verbose --maxWorkers=1",
    "check:fast": "bun run lint && bun run typecheck",
    "check": "bun run lint && bun run test && bun run build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "type": "module",
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@ant-design/x": "^2.8.0",
    "@ant-design/x-markdown": "^2.8.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.17",
    "@xyflow/react": "^12.11.2",
    "antd": "^6.5.0",
    "dayjs": "^1.11.21",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "i18next": "^26.3.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.9"
  }
}
